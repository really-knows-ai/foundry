    "dist/skills/",
    "dist/scripts/",
    "dist/docs/",
    "dist/README.md",
    "dist/LICENSE",
    "dist/CHANGELOG.md"
  ],
  "devDependencies": {
    "eslint": "^9.39.4",
    "globals": "^17.6.0"
  }
