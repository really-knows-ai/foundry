{
  "name": "@really-knows-ai/foundry",
  "version": "3.3.9",
  "description": "A skill-driven framework for governed artefact generation with AI coding tools. Define your own artefact types, laws, and flows — Foundry handles the forge → quench → appraise pipeline with deterministic routing, quality gates, and iterative refinement.",
  "type": "module",
  "main": "dist/.opencode/plugins/foundry.js",
  "license": "MIT",
  "author": "Really Knows AI",
  "packageManager": "pnpm@10.15.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/really-knows-ai/foundry.git"
  },
  "homepage": "https://github.com/really-knows-ai/foundry",
  "keywords": [
    "foundry",
    "ai",
    "artefact",
    "cycle",
    "routing",
    "quality",
    "opencode",
    "plugin"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "pnpm run build:all",
    "test": "find tests -name '*.test.js' ! -name '*.integration.test.js' ! -name '*.e2e.test.js' -print0 | xargs -0 node --test --test-reporter=dot",
    "test:unit": "pnpm run test",
    "test:integration": "find tests -name '*.integration.test.js' -print0 | xargs -0 node --test --test-reporter=dot",
    "test:e2e": "find tests -name '*.e2e.test.js' -print0 | xargs -0 node --test --test-reporter=dot",
    "test:all": "node --test --test-reporter=dot",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=dot",
    "lint": "eslint src/ tests/ scripts/",
    "build:full": "pnpm run lint --fix && pnpm run test:all && pnpm run build",
    "build:all": "pnpm run lint && pnpm run test:all && pnpm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.2.5"
  },
  "optionalDependencies": {
    "cozo-node": "^0.7.6"
  },
  "files": [
    "dist/.opencode/",
    "dist/agents/",
    "dist/skills/",
    "dist/scripts/",
    "dist/docs/",
    "dist/README.md",
    "dist/LICENSE",
    "dist/CHANGELOG.md"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "cozo-node",
      "msgpackr-extract"
    ],
    "overrides": {
      "tar@<7.5.7": ">=7.5.7",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<7.5.8": ">=7.5.8",
      "tar@<=7.5.9": ">=7.5.10",
      "tar@<=7.5.10": ">=7.5.11",
      "tar@<=7.5.3": ">=7.5.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.6.0"
  }
}
